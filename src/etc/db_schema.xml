<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="import_source_cache" resource="default" engine="innodb" comment="import_source_cache">
        <column xsi:type="int" name="cache_id" unsigned="true" nullable="false" identity="true" comment="Cache_id"/>
        <column xsi:type="varchar" name="prefix" length="255" nullable="false" comment="Prefix"/>
        <column xsi:type="varchar" name="hash_key" length="255" nullable="false" comment="Hash_key"/>
        <column xsi:type="varchar" name="data_hash" length="255" nullable="false" comment="Data_hash"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created_at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"
                comment="Updated_at"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Expires_at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cache_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="unique_data_hash">
            <column name="prefix"/>
            <column name="hash_key"/>
        </constraint>
        <index referenceId="expires_at" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>
    <table name="import_transformed_cache" resource="default" engine="innodb" comment="import_transformed_cache">
        <column xsi:type="int" name="cache_id" unsigned="true" nullable="false" identity="true" comment="Cache_id"/>
        <column xsi:type="varchar" name="prefix" length="255" nullable="false" comment="Prefix"/>
        <column xsi:type="varchar" name="hash_key" length="255" nullable="false" comment="Hash_key"/>
        <column xsi:type="varchar" name="data_hash" length="255" nullable="false" comment="Data_hash"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Created_at"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"
                comment="Updated_at"/>
        <column xsi:type="timestamp" name="expires_at" nullable="false" default="CURRENT_TIMESTAMP" comment="Expires_at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="cache_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="unique_data_hash">
            <column name="prefix"/>
            <column name="hash_key"/>
        </constraint>
        <index referenceId="expires_at" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>
    <table name="catalog_product_entity_media_gallery">
        <column xsi:type="varchar" name="hash" length="32" nullable="true" comment="Image blob hash"/>
    </table>
</schema>
